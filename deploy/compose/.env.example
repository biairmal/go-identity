# VPS stack: copy the repo root's .env.example here as deploy/compose/.env
# first (every key it documents still applies), then add these:

IMAGE_TAG=main
IMAGE=ghcr.io/biairmal/go-identity
DB_PASSWORD=change-me
DOMAIN=localhost

# Days of pg_dump files the `backup` service keeps in the `backups` volume
# before deleting them (docs/runbooks/backup-restore.md).
BACKUP_KEEP_DAYS=7
