# Copy to .env for local runs. Every key here is read by config/config.yaml.
SERVICE_NAME=go-identity
SERVICE_VERSION=dev
APP_ENV=local

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
LOG_FORMAT=json

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=identity
DB_PASSWORD=identity
DB_SSLMODE=disable

AUTH_ENABLED=false
AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json
AUTH_ISSUER=identity
AUTH_AUDIENCE=api

# Field encryption for stored emails, base64 (`openssl rand -base64 32`, two distinct values).
# Leave empty locally to use derived development keys; required in staging and production.
EMAIL_ENCRYPTION_KEY=
EMAIL_BLIND_INDEX_KEY=

TRACING_ENABLED=false
OTEL_ENDPOINT=localhost:4317

METRICS_ENABLED=true
METRICS_NAMESPACE=identity

# API docs at /swagger/index.html, behind basic auth; the password is required when enabled.
SWAGGER_ENABLED=true
SWAGGER_USERNAME=swagger
SWAGGER_PASSWORD=change-me

DRAIN_DELAY=0s

# Redis is optional: without an address the sign-in and sign-up rate limits are
# in-memory and apply per pod (a warning is logged). Set REDIS_ADDR (host:port)
# whenever more than one pod runs; REDIS_PASSWORD only if the server needs one.
REDIS_ADDR=
REDIS_PASSWORD=

IDENTITY_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

AUTH_PASSWORD_ENABLED=true
AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

REGISTRATION_ENABLED=true

# Optional: resource services calling /v1/internal with client credentials
# (modules.auth.service_clients in config.yaml). Unused, and unneeded, unless
# you add an entry there. secret_hash is the argon2id PHC string of the
# service's secret: internal/module/auth/password.Hash(secret) in a one-off
# script.
NOTES_CLIENT_SECRET_HASH=

TOKEN_ISSUER=identity
TOKEN_AUDIENCE=api
# Locally, `make keys` writes ./keys and `make run` points here.
SIGNING_KEYS_DIR=./keys

TENANCY_MODE=single

# Read on first start only, to create the one super admin (required then; later starts
# ignore them). The password must pass the password policy (10-128 characters, not a common
# password) and must be changed at the first sign-in.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Read the caller IP from X-Forwarded-For; only true behind a trusted proxy.
TRUST_PROXY=false
