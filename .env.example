# Copy to .env for local runs. Every key here is read by config/config.yaml.
SERVICE_NAME=go-identity
SERVICE_VERSION=dev
APP_ENV=local

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
LOG_FORMAT=json

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=identity
DB_PASSWORD=identity
DB_SSLMODE=disable

AUTH_ENABLED=false
AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json
AUTH_ISSUER=identity
AUTH_AUDIENCE=api

TRACING_ENABLED=false
OTEL_ENDPOINT=localhost:4317

METRICS_ENABLED=true
METRICS_NAMESPACE=identity

DRAIN_DELAY=0s
